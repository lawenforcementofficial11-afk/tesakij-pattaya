# คัดลอกเป็น .env แล้วแก้ไข (ห้าม commit ไฟล์ .env)
PORT=3000
# ใช้อย่างใดอย่างหนึ่ง: รหัสผ่านตรง ๆ (จะถูก hash ด้วย bcrypt ตอนเริ่มเซิร์ฟเวอร์) หรือ hash ที่สร้างไว้แล้ว
ADMIN_PASSWORD=change-me-to-a-long-password
# ADMIN_PASSWORD_HASH=$2a$12$....   (สร้างด้วย: npm run hash-password -- "รหัสผ่าน")
# ความลับสำหรับเซ็นคุกกี้ session (สุ่มยาว ๆ อย่างน้อย 32 ตัวอักษร)
SESSION_SECRET=replace-with-a-long-random-string
# ตั้งเป็น 1 เมื่อรันหลัง HTTPS (reverse proxy) เพื่อใช้คุกกี้แบบ Secure
COOKIE_SECURE=0

# ---- Chatbot (ไม่บังคับ) — ถ้าไม่ตั้ง AI_API_KEY บอทจะตอบจากฐานความรู้แบบออฟไลน์ ----
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1        # xAI: https://api.x.ai/v1 · Gemini: https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gpt-4o-mini                          # เช่น grok-3-mini, gemini-2.0-flash

# ---- เสียงพูดน้องอัศวิน ฝั่งเซิร์ฟเวอร์ (ไม่บังคับ) — ไม่ตั้ง = ใช้เสียงในเบราว์เซอร์ (ฟรี) ----
# TTS_PROVIDER=openai              # openai | google
# TTS_API_KEY=sk-...               # ไม่ตั้ง = ใช้ AI_API_KEY
# TTS_BASE_URL=https://api.openai.com/v1
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE_MALE=echo              # เสียงผู้ชาย (ค่าเริ่มต้นของน้องอัศวิน) · TTS_VOICE_FEMALE=nova
# GOOGLE_TTS_API_KEY=AIza...       # สำหรับ TTS_PROVIDER=google (เปิด Cloud Text-to-Speech API และจำกัดกุญแจ)
# GOOGLE_TTS_VOICE_TH=             # ชื่อเสียงเจาะจง เช่น เสียงผู้ชายภาษาไทยที่มีในบัญชี (ดูรายชื่อใน Google Cloud console)

# ---- Live Traffic 3D (ไม่บังคับ) — ตั้งในหลังบ้านได้เช่นกัน (ค่าในหลังบ้านมีผลก่อน) ----
# GOOGLE_MAPS_API_KEY=AIza...      # จำกัดด้วย HTTP referrer เป็นโดเมนของเว็บไซต์
# GOOGLE_MAPS_MAP_ID=xxxxxxxxxxxx  # Map ID แบบ Vector ที่เปิด Tilt และ Rotation
# TRUST_PROXY=1          # ตั้งเมื่ออยู่หลัง proxy ของโฮสต์ (Render/Railway) เพื่อให้ rate limit อ่าน IP ถูกต้อง
# SEED_DEMO_ALERTS=1     # โหมดเดโม: ใส่การแจ้งเหตุ "ตัวอย่าง" อัตโนมัติเมื่อไม่มีเหตุที่แสดงอยู่
